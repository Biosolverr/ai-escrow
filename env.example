GENLAYER_NETWORK=testnet-bradbury

# The following are only needed if you also run GenLayer Studio locally
# (studionet) to simulate validators on your own machine — that local
# simulator has no LLM provider of its own, so you supply one. Real
# networks like testnet-bradbury use validators that already have
# their own configured LLM providers; you don't need to supply keys
# for contract execution there.
# GROQ_API_KEY=
# GLM_API_KEY=
# SERPER_API_KEY=
